# Network overrides. Leave unset to use the documented Somnia Hideki testnet endpoints.
# NEXT_PUBLIC_SIDECAR_RPC_URL=https://api.hideki2.infra.testnet.somnia.network
# NEXT_PUBLIC_SIDECAR_WS_URL=wss://api.hideki2.infra.testnet.somnia.network/ws
# NEXT_PUBLIC_SIDECAR_INDEXER_URL=https://hideki-dev.smk.somnia.host/v1/graphql
# NEXT_PUBLIC_SIDECAR_EXPLORER_URL=https://explorer.testnet.somnia.network/tokyo

# How long Sidecar waits for a receipt before reporting an unknown outcome (milliseconds, default 60000).
# NEXT_PUBLIC_SIDECAR_RECEIPT_TIMEOUT_MS=60000

# Live integration tests (npm run test:integration). Public addresses only, never keys.
# SIDECAR_TEST_ACCOUNT_A=0x...
# SIDECAR_TEST_ACCOUNT_B=0x...

# Optional CLI smoke order (npm run smoke:order). Use a throwaway testnet key and keep it in
# .env.local, which git ignores. The script only previews unless you pass --execute.
# SIDECAR_SMOKE_PRIVATE_KEY=
